# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Large / regenerable raw OSM extracts (keep processed CSVs/metadata auditable)
data/raw/**/*.osm.pbf
data/raw/**/*.osm
data/raw/**/*.pbf
data/raw/**/*.md5
data/raw/**/*.sha256
data/raw/**/*.bbox.json
data/raw/**/*.html
data/raw/**/*.partial
!data/raw/.gitkeep

# Large regenerable graph exports (rebuild via scripts/build_pilot.py)
data/processed/pilot_network.graphml
data/processed/pilot_network.geojson
data/processed/multiroute/pilot_network.graphml
data/processed/multiroute/pilot_network.geojson
data/processed/multiroute/road_nodes.csv
data/processed/multiroute/road_edges.csv
results/baseline_routes.geojson
reports/pilot_corridor_report.html

# Keep the small static PNG in git for review
!reports/pilot_corridor_overview.png

# Large weather / DEM caches (regenerate via scripts/fetch_corridor_*.py)
data/raw/weather/**
!data/raw/weather/.gitkeep
data/raw/dem/**
!data/raw/dem/.gitkeep
# Keep small processed energy metadata / profiles if present; large tifs stay under raw/
data/raw/dem/**/*.tif
data/raw/dem/**/*.partial

# Regenerable Morocco DRIVE tables (rebuild via scripts/run_morocco_routing.py)
data/processed/optimization/drive_tables/

# Local caches
*.tmp
*.log
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
