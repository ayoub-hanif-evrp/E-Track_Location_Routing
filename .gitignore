# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.env

# Testing / tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Large / regenerable raw OSM extracts (keep processed CSVs/metadata auditable)
data/raw/**/*.osm.pbf
data/raw/**/*.osm
data/raw/**/*.pbf
data/raw/**/*.md5
data/raw/**/*.sha256
data/raw/**/*.bbox.json
data/raw/**/*.html
data/raw/**/*.partial
!data/raw/.gitkeep

# Large regenerable graph exports (rebuild via scripts/build_pilot.py)
data/processed/pilot_network.graphml
data/processed/pilot_network.geojson
data/processed/multiroute/pilot_network.graphml
data/processed/multiroute/pilot_network.geojson
data/processed/multiroute/road_nodes.csv
data/processed/multiroute/road_edges.csv
# Packed CI graph artifact (host as release asset; see pack_multiroute_graph_artifact.py)
artifacts/multiroute_graph.zip
# Large multiroute graph CSVs (CI downloads multiroute-graph-v1 release asset)
data/processed/multiroute/nodes.csv
data/processed/multiroute/edges.csv
results/paper_campaign/_enum_cache_*.pkl
results/paper_campaign/_enum_progress_*.json
stage_c_headline_enum.log
results/baseline_routes.geojson
reports/pilot_corridor_report.html
# Local debug / agent scratch
review.txt
scripts/_*.py
**/__pycache__/
*.pyc

# Keep the small static PNG in git for review
!reports/pilot_corridor_overview.png

# Large weather / DEM caches (regenerate via scripts/fetch_corridor_*.py)
data/raw/weather/**
!data/raw/weather/.gitkeep
data/raw/dem/**
!data/raw/dem/.gitkeep
# Keep small processed energy metadata / profiles if present; large tifs stay under raw/
data/raw/dem/**/*.tif
data/raw/dem/**/*.partial

# Regenerable Morocco DRIVE tables (rebuild via scripts/run_morocco_routing.py)
data/processed/optimization/drive_tables/
data/processed/multiroute/drive_tables/
data/raw/dem/

# Local caches
*.tmp
*.log
.DS_Store
Thumbs.db

# Ephemeral campaign solver configs (regenerated each run)
results/paper_campaign/_tmp_cfgs/

# IDE
.idea/
.vscode/
*.swp
